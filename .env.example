# Copy this file to .env at the repository root.
# Fill in only the settings for the servers you use. Keep credentials in .env.

# Docs MCP. Set the sitemap URL to enable Docusaurus website mode.
# DOCS_SITEMAP_URL=https://docs.example/handbook/sitemap.xml
DOCS_SITEMAP_URL=
# Optional URL path prefix within the website, such as /handbook/docs.
DOCS_SITE_PATH=
# Corporate TLS: let Node use the OS certificate store (needed for many internal HTTPS sites).
# NODE_OPTIONS=--use-system-ca

# Local Markdown mode. A blank root uses the bundled sample documents.
DOCS_ROOT=
DOCS_IGNORE_DIRS=

# Jira Server / Data Center. Use a PAT or provide a username and password.
JIRA_BASE_URL=
JIRA_PAT=
JIRA_USERNAME=
JIRA_PASSWORD=

# Confluence Server / Data Center. Use a PAT or provide a username and password.
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=

# Optional HTTP port overrides. Uncomment to change a default.
# DOCS_HTTP_PORT=3101
# JIRA_HTTP_PORT=3102
# CONFLUENCE_HTTP_PORT=3103