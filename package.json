{
  "name": "my-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Unified and standalone MCP servers for Markdown docs, Jira, and Confluence",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "mcp": "npm run start -w @my-mcp/my-mcp",
    "mcp:http": "npm run start:http -w @my-mcp/my-mcp",
    "docs": "npm run start -w @my-mcp/docs-mcp",
    "docs:http": "npm run start:http -w @my-mcp/docs-mcp",
    "jira": "npm run start -w @my-mcp/jira-mcp",
    "jira:http": "npm run start:http -w @my-mcp/jira-mcp",
    "confluence": "npm run start -w @my-mcp/confluence-mcp",
    "confluence:http": "npm run start:http -w @my-mcp/confluence-mcp",
    "inspect:docs": "npx @modelcontextprotocol/inspector npm run docs",
    "inspect:jira": "npx @modelcontextprotocol/inspector npm run jira",
    "inspect:confluence": "npx @modelcontextprotocol/inspector npm run confluence",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke:docs": "node scripts/smoke-docs.mjs",
    "smoke:docs:website": "node scripts/smoke-docs-website.mjs",
    "smoke:jira": "node scripts/smoke-jira-list.mjs",
    "test:http": "node --test scripts/http-integration.test.mjs",
    "test:stdio": "node --test scripts/stdio-integration.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
